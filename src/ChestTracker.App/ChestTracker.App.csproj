<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 SDK projection is needed for Windows.Graphics.Capture. -->
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- Only for the system tray NotifyIcon and GDI capture fallback. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ChestTracker.App</RootNamespace>
    <AssemblyName>FortniteChestTracker</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TieredPGO>true</TieredPGO>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms implicit usings clash with WPF type names. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20241108" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20241108" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChestTracker.Core\ChestTracker.Core.csproj" />
    <ProjectReference Include="..\ChestTracker.Sync\ChestTracker.Sync.csproj" />
    <ProjectReference Include="..\ChestTracker.Vision\ChestTracker.Vision.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Official chest logo as a multi-size icon: embedded in the .exe (Explorer) and used by the window and taskbar. -->
    <Resource Include="Assets\app.ico" />
    <!-- Bundled YOLOv8 chest model (closed_chest / open_chest). Published next to the executable as models\best.onnx.
         Kept outside the single-file bundle: the model is opened from disk by path. -->
    <None Include="models\best.onnx" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <!-- DirectML runtime for GPU inference (Microsoft.AI.DirectML, a dependency of Microsoft.ML.OnnxRuntime.DirectML).
         The package copies it only for C++ projects; without it Windows' older System32 copy would be used. -->
    <None Include="$(NuGetPackageRoot)microsoft.ai.directml\1.15.2\bin\x64-win\DirectML.dll" Link="DirectML.dll"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!-- Native import libraries (.lib) are build-time files only; never ship them. -->
  <Target Name="DropNativeImportLibraries" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.lib'" />
    </ItemGroup>
  </Target>
</Project>
