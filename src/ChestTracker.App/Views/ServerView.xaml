<UserControl x:Class="ChestTracker.App.Views.ServerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ChestTracker.App.ViewModels"
             xmlns:sync="clr-namespace:ChestTracker.Sync;assembly=ChestTracker.Sync"
             Style="{StaticResource PageRoot}">
    <UserControl.Resources>
        <Style x:Key="Section" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Padding" Value="22,18" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,32">
            <TextBlock Text="{DynamicResource Server.Title}" Style="{StaticResource Text.H1}" Margin="0,0,0,18" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="2*" MinWidth="300" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <!-- Connection -->
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <DockPanel>
                                <!-- Ping indicator -->
                                <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="{StaticResource Brush.SurfaceAlt}" Padding="10,5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE701;" FontSize="12" Margin="0,0,6,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Icon}">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Latency}" Value="{x:Static vm:LatencyLevel.Good}">
                                                            <Setter Property="Foreground" Value="{StaticResource Brush.Success}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Latency}" Value="{x:Static vm:LatencyLevel.Fair}">
                                                            <Setter Property="Foreground" Value="{StaticResource Brush.Warning}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Latency}" Value="{x:Static vm:LatencyLevel.Poor}">
                                                            <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding LatencyText}" FontFamily="Consolas" FontSize="12.5" />
                                    </StackPanel>
                                </Border>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="10" Height="10" Margin="0,0,10,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource Brush.TextDim}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static sync:SyncStatus.Online}">
                                                        <Setter Property="Fill" Value="{StaticResource Brush.Success}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static sync:SyncStatus.Connecting}">
                                                        <Setter Property="Fill" Value="{StaticResource Brush.AccentLight}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static sync:SyncStatus.Offline}">
                                                        <Setter Property="Fill" Value="{StaticResource Brush.Warning}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static sync:SyncStatus.Incompatible}">
                                                        <Setter Property="Fill" Value="{StaticResource Brush.Danger}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.H2}" FontSize="16" />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Text="{Binding ServerInfoText}" Style="{StaticResource Text.Caption}" Margin="20,4,0,0"
                                       Visibility="{Binding ServerInfoText, Converter={StaticResource NullToVis}}" />

                            <TextBlock Text="{DynamicResource Server.Url}" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
                            <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                            <TextBlock Text="{DynamicResource Server.UrlHint}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
                            <Border Background="{StaticResource Brush.WarningSoft}" CornerRadius="8" Padding="10,6" Margin="0,8,0,0"
                                    Visibility="{Binding IsInsecure, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{DynamicResource Server.Insecure}" TextWrapping="Wrap" FontSize="12" Foreground="#FDE68A" />
                            </Border>

                            <WrapPanel Margin="0,14,0,0">
                                <Button Content="{DynamicResource Server.Connect}" Style="{StaticResource Button.Accent}" Margin="0,0,8,8"
                                        Command="{Binding ConnectCommand}" IsEnabled="{Binding CanConnect}" />
                                <Button Content="{DynamicResource Server.Disconnect}" Margin="0,0,8,8" Command="{Binding DisconnectCommand}"
                                        IsEnabled="{Binding CanDisconnect}" />
                                <Button Content="{DynamicResource Server.Test}" Style="{StaticResource Button.Ghost}" Margin="0,0,8,8"
                                        Command="{Binding TestCommand}" />
                            </WrapPanel>
                            <CheckBox Content="{DynamicResource Server.AutoConnect}" IsChecked="{Binding AutoConnect}" />

                            <Border Background="{StaticResource Brush.DangerSoft}" CornerRadius="8" Padding="12,8" Margin="0,10,0,0"
                                    Visibility="{Binding ErrorText, Converter={StaticResource NullToVis}}">
                                <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" FontSize="12.5" Foreground="#FDA4AF" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Saved servers -->
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Server.Saved}" Style="{StaticResource Text.H2}" Margin="0,0,0,8" />
                            <TextBlock Text="{DynamicResource Server.NoSaved}" Style="{StaticResource Text.Caption}"
                                       Visibility="{Binding SavedServers.Count, Converter={StaticResource ZeroToVis}}" />
                            <ItemsControl ItemsSource="{Binding SavedServers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:SavedServerItem}">
                                        <Border Padding="2,7" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Content="&#xE74D;" Foreground="#FDA4AF"
                                                        ToolTip="{DynamicResource Server.Forget}"
                                                        Command="{Binding DataContext.ForgetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Padding="10,5" Margin="0,0,6,0"
                                                        Content="{DynamicResource Server.Use}"
                                                        Command="{Binding DataContext.UseSavedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Url}" FontFamily="Consolas" />
                                                    <TextBlock Style="{StaticResource Text.Caption}">
                                                        <Run Text="{Binding AccountText, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding LastText, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Account -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Server.AccountTitle}" Style="{StaticResource Text.H2}" />
                            <TextBlock Text="{Binding AccountText}" Margin="0,6,0,0" FontSize="13" />

                            <!-- Sign in (no credential for this server yet) -->
                            <StackPanel Visibility="{Binding IsSignedIn, Converter={StaticResource InvBoolToVis}}" Margin="0,8,0,0">
                                <Border Background="{StaticResource Brush.SurfaceAlt}" CornerRadius="10" Padding="4">
                                    <UniformGrid Columns="3">
                                        <RadioButton Style="{StaticResource Segment}" GroupName="SignIn" Padding="4,7" Content="{DynamicResource Server.Mode.Guest}"
                                                     IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter=Guest}" />
                                        <RadioButton Style="{StaticResource Segment}" GroupName="SignIn" Padding="4,7" Content="{DynamicResource Server.Mode.Login}"
                                                     IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter=Login}" />
                                        <RadioButton Style="{StaticResource Segment}" GroupName="SignIn" Padding="4,7" Content="{DynamicResource Server.Mode.Create}"
                                                     IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter=CreateAccount}" />
                                    </UniformGrid>
                                </Border>

                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Mode}" Value="{x:Static vm:SignInMode.Login}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="{DynamicResource Party.DisplayName}" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" MaxLength="32" />
                                </StackPanel>

                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Mode}" Value="{x:Static vm:SignInMode.Guest}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="{DynamicResource Server.Username}" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" MaxLength="24" />
                                    <TextBlock Text="{DynamicResource Server.Password}" Style="{StaticResource FieldLabel}" />
                                    <PasswordBox x:Name="Password" MaxLength="128" />
                                </StackPanel>

                                <Button Content="{DynamicResource Server.SignIn}" Style="{StaticResource Button.Accent}" HorizontalAlignment="Left"
                                        Margin="0,14,0,0" Command="{Binding SignInCommand}" CommandParameter="{Binding ElementName=Password}" />
                                <TextBlock Text="{DynamicResource Server.SignInHint}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" />
                            </StackPanel>

                            <!-- Guest → account -->
                            <StackPanel Visibility="{Binding IsGuest, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
                                <TextBlock Text="{DynamicResource Server.ClaimTitle}" FontWeight="SemiBold" />
                                <TextBlock Text="{DynamicResource Server.ClaimHint}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
                                <TextBlock Text="{DynamicResource Server.Username}" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" MaxLength="24" />
                                <TextBlock Text="{DynamicResource Server.Password}" Style="{StaticResource FieldLabel}" />
                                <PasswordBox x:Name="ClaimPassword" MaxLength="128" />
                                <Button Content="{DynamicResource Server.Claim}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                        Command="{Binding ClaimCommand}" CommandParameter="{Binding ElementName=ClaimPassword}" />
                            </StackPanel>

                            <Button Content="{DynamicResource Server.SignOut}" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left"
                                    Margin="-8,12,0,0" Command="{Binding SignOutCommand}"
                                    Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Server.SecurityTitle}" Style="{StaticResource Text.H2}" Margin="0,0,0,6" />
                            <TextBlock Text="{DynamicResource Server.SecurityText}" Style="{StaticResource Text.Caption}" FontSize="12.5" LineHeight="19" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
