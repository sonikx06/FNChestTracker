<Window x:Class="ChestTracker.App.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="Height" Width="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Border Margin="16" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
            CornerRadius="16" Padding="24" Effect="{StaticResource Shadow.Soft}">
        <StackPanel>
            <TextBlock x:Name="TitleText" Style="{StaticResource Text.H2}" Margin="0,0,0,10" />
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="{StaticResource Brush.TextMuted}" FontSize="13.5" LineHeight="20" />
            <TextBox x:Name="Input" Margin="0,16,0,0" Visibility="Collapsed" />
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource Brush.Danger}" FontSize="12" Margin="0,6,0,0" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="CancelButton" Content="{DynamicResource Common.Cancel}" Style="{StaticResource Button.Ghost}" IsCancel="True"
                        Margin="0,0,8,0" MinWidth="96" Click="OnCancel" />
                <Button x:Name="OkButton" Content="{DynamicResource Common.Ok}" Style="{StaticResource Button.Accent}" IsDefault="True"
                        MinWidth="96" Click="OnOk" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
