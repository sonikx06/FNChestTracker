<UserControl x:Class="ChestTracker.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ChestTracker.App.ViewModels"
             Style="{StaticResource PageRoot}">
    <DockPanel Margin="32,28,32,28">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Command="{Binding RefreshCommand}" Style="{StaticResource Button.Icon}" Content="&#xE72C;" Margin="0,0,8,0"
                        ToolTip="{DynamicResource Common.Refresh}" />
                <Button Command="{Binding ExportCsvCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" Style="{StaticResource Text.Icon}" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="{DynamicResource Hist.ExportCsv}" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Text="{DynamicResource Hist.Title}" Style="{StaticResource Text.H1}" />
        </DockPanel>

        <!-- Filters -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="120" />
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}" Padding="34,8,10,8" />
                <TextBlock Text="&#xE721;" Style="{StaticResource Text.Icon}" FontSize="13" Margin="12,0,0,0" HorizontalAlignment="Left"
                           Foreground="{StaticResource Brush.TextDim}" IsHitTestVisible="False" />
                <TextBlock Text="{DynamicResource Hist.Search}" Margin="35,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="{StaticResource Brush.TextDim}" FontSize="13">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <ComboBox Grid.Column="2" ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod}" DisplayMemberPath="Label" />
            <ComboBox Grid.Column="4" ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" DisplayMemberPath="Label" />
            <Grid Grid.Column="6">
                <TextBox Text="{Binding MinChestsText, UpdateSourceTrigger=PropertyChanged, Delay=200}" ToolTip="{DynamicResource Hist.MinChests}" />
                <TextBlock Text="{DynamicResource Hist.MinChests}" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="{StaticResource Brush.TextDim}" FontSize="12.5">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MinChestsText}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding SummaryText}" Style="{StaticResource Text.Label}" Margin="4,12,0,0" />

        <Border Style="{StaticResource Card}" Padding="8">
            <Grid>
                <DataGrid x:Name="MatchesGrid" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                          MouseDoubleClick="OnRowDoubleClick" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="1.6*" SortMemberPath="Summary.Match.StartedAt">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="{DynamicResource Hist.Col.Start}" Foreground="{StaticResource Brush.TextMuted}" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:MatchRowViewModel}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding StartText}" FontFamily="Consolas" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Binding="{Binding DurationText}" Width="*" SortMemberPath="Summary.Match.EndedAt">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Hist.Col.Duration}" Foreground="{StaticResource Brush.TextMuted}" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Width="0.9*" SortMemberPath="Chests">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="{DynamicResource Hist.Col.Chests}" Foreground="{StaticResource Brush.TextMuted}" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:MatchRowViewModel}">
                                    <Border Style="{StaticResource Badge}" HorizontalAlignment="Left" MinWidth="38">
                                        <TextBlock Text="{Binding Chests}" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource Brush.AccentLight}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Binding="{Binding ManualAdds}" Width="0.8*">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Hist.Col.Manual}" Foreground="{StaticResource Brush.TextMuted}" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding AutomaticAdds}" Width="0.7*">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Hist.Col.Auto}" Foreground="{StaticResource Brush.TextMuted}" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Corrections}" Width="0.9*">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Hist.Col.Corrections}" Foreground="{StaticResource Brush.TextMuted}" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding ModeText}" Width="1.1*">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Hist.Col.Mode}" Foreground="{StaticResource Brush.TextMuted}" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Width="1.1*" SortMemberPath="StatusText">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="{DynamicResource Hist.Col.Status}" Foreground="{StaticResource Brush.TextMuted}" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:MatchRowViewModel}">
                                    <TextBlock x:Name="T" Text="{Binding StatusText}" Foreground="{StaticResource Brush.TextMuted}" />
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter TargetName="T" Property="Foreground" Value="{StaticResource Brush.Success}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Binding="{Binding ShortId}" Width="0.9*" FontFamily="Consolas" Foreground="{StaticResource Brush.TextDim}">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Hist.Col.Id}" Foreground="{StaticResource Brush.TextMuted}" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Width="86" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:MatchRowViewModel}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource Button.Icon}" Width="30" Height="30" Content="&#xE70F;" Margin="0,0,4,0"
                                                ToolTip="{DynamicResource Common.Edit}"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource Button.Icon}" Width="30" Height="30" Content="&#xE74D;" Foreground="#FDA4AF"
                                                ToolTip="{DynamicResource Common.Delete}"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="{DynamicResource Hist.Empty}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Style="{StaticResource Text.Caption}" FontSize="14"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
