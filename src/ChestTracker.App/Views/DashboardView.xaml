<UserControl x:Class="ChestTracker.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ChestTracker.App.ViewModels"
             xmlns:c="clr-namespace:ChestTracker.App.Controls"
             Style="{StaticResource PageRoot}">
    <UserControl.Resources>
        <Style x:Key="StatValue" TargetType="TextBlock" BasedOn="{StaticResource Text.Number}">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="RenderTransformOrigin" Value="0,0.5" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,32">
            <!-- Header -->
            <DockPanel Margin="0,0,0,22">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource Badge}" Background="{StaticResource Brush.SurfaceAlt}" Padding="10,6" Margin="0,0,10,0"
                            Visibility="{Binding IsDetectionMode, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                     Fill="{Binding DataContext.Overlay.DetectionBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <TextBlock Text="{Binding DetectionStatusText}" FontSize="12" Foreground="{StaticResource Brush.TextMuted}" />
                        </StackPanel>
                    </Border>
                    <Button Command="{Binding ToggleOverlayEditCommand}" Style="{StaticResource Button.Ghost}" Padding="12,7">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7C2;" Style="{StaticResource Text.Icon}" FontSize="13" Margin="0,0,8,0" Foreground="{StaticResource Brush.TextMuted}" />
                            <TextBlock Text="{DynamicResource Dash.MoveOverlay}" Foreground="{StaticResource Brush.TextMuted}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock Text="{DynamicResource Dash.Title}" Style="{StaticResource Text.H1}" />
            </DockPanel>

            <!-- Hero: current match -->
            <Border CornerRadius="18" Padding="28,24" Background="{StaticResource Brush.HeroGradient}"
                    BorderBrush="#40A855F7" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Dash.CurrentMatch}" Style="{StaticResource Text.Label}" FontSize="13" VerticalAlignment="Center" />
                        <Border Margin="12,0,0,0" CornerRadius="9" Padding="9,3" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource Brush.SurfaceAlt}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMatchActive}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Brush.SuccessSoft}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource Brush.TextDim}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMatchActive}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource Brush.Success}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding MatchStateText}" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{Binding MatchCount}" FontSize="88" FontWeight="Bold" FontFamily="{StaticResource Font.Display}"
                                   Foreground="White" c:Pulse.OnChange="{Binding MatchCount}" Effect="{StaticResource Shadow.Glow}" />
                        <StackPanel VerticalAlignment="Bottom" Margin="16,0,0,22">
                            <TextBlock Text="{DynamicResource Dash.ChestsOpened}" FontSize="15" Foreground="{StaticResource Brush.TextMuted}" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="&#xE916;" Style="{StaticResource Text.Icon}" FontSize="13" Foreground="{StaticResource Brush.AccentLight}" Margin="0,0,7,0" />
                                <TextBlock Text="{Binding DurationText}" FontSize="15" FontWeight="SemiBold" FontFamily="Consolas" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0">
                        <!-- One state-dependent button: Start Match (green play) / End Match (red stop). -->
                        <Button x:Name="MatchToggle" Command="{Binding ToggleMatchCommand}" Margin="0,0,8,0" MinWidth="148"
                                AutomationProperties.AutomationId="MatchToggle">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.Success}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMatchActive}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Brush.DangerSoft}" />
                                            <Setter Property="BorderBrush" Value="#55F43F5E" />
                                            <Setter Property="Foreground" Value="#FDA4AF" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Icon}">
                                            <Setter Property="Text" Value="&#xE768;" />
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Success}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMatchActive}" Value="True">
                                                    <Setter Property="Text" Value="&#xE71A;" />
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Text" Value="{DynamicResource Dash.StartMatch}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMatchActive}" Value="True">
                                                    <Setter Property="Text" Value="{DynamicResource Dash.EndMatch}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding EditCountCommand}" Margin="0,0,8,0" IsEnabled="{Binding IsMatchActive}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE70F;" Style="{StaticResource Text.Icon}" FontSize="12" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource Dash.EditCount}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Button.Danger}" Command="{Binding ResetMatchCommand}" IsEnabled="{Binding IsMatchActive}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" Style="{StaticResource Text.Icon}" FontSize="12" Foreground="#FDA4AF" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource Dash.ResetMatch}" Foreground="#FDA4AF" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- +1 / -1 -->
                    <StackPanel Grid.Column="1" Grid.RowSpan="3" VerticalAlignment="Center" Margin="24,0,0,0">
                        <Button Style="{StaticResource Button.Big}" Width="96" Height="96" FontSize="38" Content="+1"
                                Command="{Binding AddChestCommand}" ToolTip="{DynamicResource Dash.AddChest}" Effect="{StaticResource Shadow.Glow}" />
                        <Button Width="96" Height="44" Margin="0,10,0,0" FontSize="18" FontWeight="Bold" Content="−1"
                                Command="{Binding RemoveChestCommand}" ToolTip="{DynamicResource Dash.RemoveChest}" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="{Binding HotkeyHint}" Style="{StaticResource Text.Caption}" Margin="4,10,0,0" FontSize="12" />

            <!-- Stat cards -->
            <UniformGrid Columns="4" Margin="-6,18,-6,0">
                <Border Style="{StaticResource Card}" Margin="6">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Dash.Lifetime}" Style="{StaticResource Text.Label}" />
                        <TextBlock Text="{Binding LifetimeCount}" Style="{StaticResource StatValue}" Foreground="{StaticResource Brush.AccentLight}"
                                   c:Pulse.OnChange="{Binding LifetimeCount}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Dash.Matches}" Style="{StaticResource Text.Label}" />
                        <TextBlock Text="{Binding MatchesPlayed}" Style="{StaticResource StatValue}" c:Pulse.OnChange="{Binding MatchesPlayed}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Dash.Average}" Style="{StaticResource Text.Label}" />
                        <TextBlock Text="{Binding AverageText}" Style="{StaticResource StatValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE734;" Style="{StaticResource Text.Icon}" FontSize="12" Foreground="{StaticResource Brush.Gold}" Margin="0,0,6,0" />
                            <TextBlock Text="{DynamicResource Dash.Record}" Style="{StaticResource Text.Label}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Record}" Style="{StaticResource StatValue}" Foreground="{StaticResource Brush.Gold}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Events + side panel -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" MinHeight="300">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Dash.RecentEvents}" Style="{StaticResource Text.H2}" Margin="0,0,0,12" />
                        <Grid>
                            <TextBlock Text="{DynamicResource Dash.NoEvents}" Style="{StaticResource Text.Caption}" FontSize="13" Margin="0,8"
                                       Visibility="{Binding HasEvents, Converter={StaticResource InvBoolToVis}}" />
                            <ItemsControl ItemsSource="{Binding RecentEvents}" MaxHeight="420">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:EventItemViewModel}">
                                        <Border Padding="4,8" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="54" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="Pill" CornerRadius="8" Width="42" Height="26" HorizontalAlignment="Left"
                                                        Background="{StaticResource Brush.SuccessSoft}">
                                                    <TextBlock x:Name="Delta" Text="{Binding DeltaText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               FontWeight="Bold" Foreground="#86EFAC" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="13" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ConfidenceText}" Style="{StaticResource Text.Caption}" Margin="0,0,12,0" />
                                                    <TextBlock Text="{Binding TimeText}" Style="{StaticResource Text.Caption}" FontFamily="Consolas" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:DeltaKind.Negative}">
                                                <Setter TargetName="Pill" Property="Background" Value="{StaticResource Brush.DangerSoft}" />
                                                <Setter TargetName="Delta" Property="Foreground" Value="#FDA4AF" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:DeltaKind.Neutral}">
                                                <Setter TargetName="Pill" Property="Background" Value="{StaticResource Brush.AccentSoft}" />
                                                <Setter TargetName="Delta" Property="Foreground" Value="{StaticResource Brush.AccentLight}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DockPanel>
                </Border>

                <StackPanel Grid.Column="2">
                    <!-- Uncertain detections -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16" BorderBrush="#66F59E0B"
                            Visibility="{Binding HasPendingReviews, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BA;" Style="{StaticResource Text.Icon}" Foreground="{StaticResource Brush.Warning}" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource Dash.PendingReviews}" Style="{StaticResource Text.H2}" />
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Dash.PendingHint}" Style="{StaticResource Text.Caption}" Margin="0,6,0,10" />
                            <ItemsControl ItemsSource="{Binding PendingReviews}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ReviewItemViewModel}">
                                        <DockPanel Margin="0,4">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Padding="10,5" Content="{DynamicResource Common.Reject}"
                                                    Command="{Binding DataContext.RejectReviewCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Success}" Padding="10,5" Margin="0,0,6,0"
                                                    Content="{DynamicResource Common.Accept}"
                                                    Command="{Binding DataContext.AcceptReviewCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TimeText}" FontFamily="Consolas" />
                                                <TextBlock Text="{Binding ConfidenceText}" Style="{StaticResource Text.Caption}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Tracking mode -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Set.Mode}" Style="{StaticResource Text.H2}" Margin="0,0,0,12" />
                            <Border Background="{StaticResource Brush.SurfaceAlt}" CornerRadius="10" Padding="4">
                                <UniformGrid Columns="3">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="DashMode" Content="{DynamicResource Mode.Manual.Short}"
                                                 IsChecked="{Binding Settings.TrackingMode, Converter={StaticResource EnumEquals}, ConverterParameter=Manual}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="DashMode" Content="{DynamicResource Mode.Hybrid.Short}"
                                                 IsChecked="{Binding Settings.TrackingMode, Converter={StaticResource EnumEquals}, ConverterParameter=Hybrid}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="DashMode" Content="{DynamicResource Mode.Automatic.Short}"
                                                 IsChecked="{Binding Settings.TrackingMode, Converter={StaticResource EnumEquals}, ConverterParameter=Automatic}" />
                                </UniformGrid>
                            </Border>
                            <TextBlock Text="{Binding ModeDescription}" Style="{StaticResource Text.Caption}" FontSize="12.5" Margin="2,12,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="2,10,0,0" Visibility="{Binding IsDetectionMode, Converter={StaticResource BoolToVis}}">
                                <Border Style="{StaticResource Badge}" Background="{StaticResource Brush.WarningSoft}">
                                    <TextBlock Text="{DynamicResource Common.Experimental}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Brush.Warning}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
