<UserControl x:Class="ChestTracker.App.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ChestTracker.App.Controls"
             Style="{StaticResource PageRoot}">
    <UserControl.Resources>
        <Style x:Key="BestValue" TargetType="TextBlock" BasedOn="{StaticResource Text.Number}">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="Margin" Value="0,6,0,2" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,32">
            <TextBlock Text="{DynamicResource Stats.Title}" Style="{StaticResource Text.H1}" Margin="0,0,0,22" />

            <!-- Personal bests -->
            <TextBlock Text="{DynamicResource Stats.Bests}" Style="{StaticResource Text.H2}" Margin="0,0,0,10" />
            <UniformGrid Columns="5" Margin="-6,0,-6,10">
                <Border Style="{StaticResource Card}" Margin="6" BorderBrush="#55FBBF24">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE734;" Style="{StaticResource Text.Icon}" FontSize="12" Foreground="{StaticResource Brush.Gold}" Margin="0,0,6,0" />
                            <TextBlock Text="{DynamicResource Stats.BestMatch}" Style="{StaticResource Text.Label}" />
                        </StackPanel>
                        <TextBlock Text="{Binding BestMatchText}" Style="{StaticResource BestValue}" Foreground="{StaticResource Brush.Gold}" />
                        <TextBlock Text="{Binding BestMatchDate}" Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Stats.BestDay}" Style="{StaticResource Text.Label}" />
                        <TextBlock Text="{Binding BestDayText}" Style="{StaticResource BestValue}" />
                        <TextBlock Text="{Binding BestDayDate}" Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Stats.BestSession}" Style="{StaticResource Text.Label}" />
                        <TextBlock Text="{Binding BestSessionText}" Style="{StaticResource BestValue}" />
                        <TextBlock Text="{Binding BestSessionDate}" Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Stats.BestRate}" Style="{StaticResource Text.Label}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding BestRateText}" Style="{StaticResource BestValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Stats.AvgOverall}" Style="{StaticResource Text.Label}" />
                        <TextBlock Text="{Binding AverageText}" Style="{StaticResource BestValue}" FontSize="22" Margin="0,10,0,2" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Stats.TotalMatches}" Style="{StaticResource Text.Caption}" />
                            <TextBlock Text=": " Style="{StaticResource Text.Caption}" />
                            <TextBlock Text="{Binding TotalMatchesText}" Style="{StaticResource Text.Caption}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Stats.PerMatch}" Style="{StaticResource Text.H2}" FontSize="15" />
                        <c:SimpleChart Height="230" Margin="0,8,0,0" Kind="Bar" Points="{Binding PerMatch}" EmptyText="{Binding EmptyText}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Stats.PerDay}" Style="{StaticResource Text.H2}" FontSize="15" />
                        <c:SimpleChart Height="230" Margin="0,8,0,0" Kind="Bar" Points="{Binding PerDay}" EmptyText="{Binding EmptyText}"
                                       Accent="#6D7BFF" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Stats.PerSession}" Style="{StaticResource Text.H2}" FontSize="15" />
                        <c:SimpleChart Height="230" Margin="0,8,0,0" Kind="Bar" Points="{Binding PerSession}" EmptyText="{Binding EmptyText}"
                                       Accent="#E879F9" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Stats.Average}" Style="{StaticResource Text.H2}" FontSize="15" />
                        <c:SimpleChart Height="230" Margin="0,8,0,0" Kind="Line" Points="{Binding RollingAverage}"
                                       SecondaryPoints="{Binding CumulativeAverage}" EmptyText="{Binding EmptyText}" ValueFormat="0.0" />
                        <StackPanel Orientation="Horizontal" Margin="4,6,0,0">
                            <Rectangle Width="14" Height="3" Fill="{StaticResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="10" Style="{StaticResource Text.Caption}" Margin="0,0,16,0" />
                            <Rectangle Width="14" Height="3" Fill="{StaticResource Brush.Gold}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Σ" Style="{StaticResource Text.Caption}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
