<Window x:Class="ChestTracker.App.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fortnite Chest Tracker"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="Height" Width="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Border Margin="16" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
            CornerRadius="16" Padding="24" Effect="{StaticResource Shadow.Soft}">
        <StackPanel>
            <TextBlock Text="{DynamicResource Update.Title}" Style="{StaticResource Text.H2}" Margin="0,0,0,8" />
            <TextBlock x:Name="VersionText" TextWrapping="Wrap" FontSize="13.5" Margin="0,0,0,10" AutomationProperties.AutomationId="UpdateVersion" />
            <TextBlock Text="{DynamicResource Update.Notes}" Style="{StaticResource Text.Label}" Margin="0,0,0,4" />
            <TextBox x:Name="NotesText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="200"
                     FontSize="12" AcceptsReturn="True" />
            <ProgressBar x:Name="Progress" Height="6" Margin="0,14,0,0" Minimum="0" Maximum="1" Visibility="Collapsed" />
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Brush.TextMuted}" Margin="0,6,0,0"
                       AutomationProperties.AutomationId="UpdateStatus" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="LaterButton" Content="{DynamicResource Update.Later}" Style="{StaticResource Button.Ghost}" IsCancel="True"
                        Margin="0,0,8,0" MinWidth="110" Click="OnLater" AutomationProperties.AutomationId="UpdateLater" />
                <Button x:Name="UpdateButton" Content="{DynamicResource Update.Now}" Style="{StaticResource Button.Accent}" IsDefault="True"
                        MinWidth="130" Click="OnUpdate" AutomationProperties.AutomationId="UpdateNow" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
