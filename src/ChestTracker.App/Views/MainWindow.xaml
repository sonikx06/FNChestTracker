<Window x:Class="ChestTracker.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ChestTracker.App.ViewModels"
        Title="{DynamicResource App.Title}"
        Width="1240" Height="800" MinWidth="1000" MinHeight="660"
        Background="{StaticResource Brush.Bg}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{StaticResource Brush.Sidebar}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,20,16,18">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,26">
                    <Image x:Name="Logo" Width="40" Height="40" Margin="0,0,12,0">
                        <Image.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Color="#A855F7" Opacity="0.6" />
                        </Image.Effect>
                    </Image>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Chest Tracker" FontSize="17" FontWeight="Bold" FontFamily="{StaticResource Font.Display}" />
                        <TextBlock Text="{DynamicResource App.Subtitle}" Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                </StackPanel>

                <!-- Status block at the bottom -->
                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="14" CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Dash.Mode}" Style="{StaticResource Text.Caption}" />
                        <UniformGrid Columns="3" Margin="0,6,0,10">
                            <RadioButton Style="{StaticResource Segment}" Padding="4,6" FontSize="11.5" GroupName="SideMode"
                                         Content="{DynamicResource Mode.Manual.Short}"
                                         IsChecked="{Binding Settings.TrackingMode, Converter={StaticResource EnumEquals}, ConverterParameter=Manual}" />
                            <RadioButton Style="{StaticResource Segment}" Padding="4,6" FontSize="11.5" GroupName="SideMode"
                                         Content="{DynamicResource Mode.Hybrid.Short}"
                                         IsChecked="{Binding Settings.TrackingMode, Converter={StaticResource EnumEquals}, ConverterParameter=Hybrid}" />
                            <RadioButton Style="{StaticResource Segment}" Padding="4,6" FontSize="11.5" GroupName="SideMode"
                                         Content="{DynamicResource Mode.Automatic.Short}"
                                         IsChecked="{Binding Settings.TrackingMode, Converter={StaticResource EnumEquals}, ConverterParameter=Automatic}"
                                         ToolTip="{DynamicResource Mode.Automatic}" />
                        </UniformGrid>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{Binding Overlay.DetectionBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding DetectionStatusText}" Style="{StaticResource Text.Caption}" TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <CheckBox Content="{DynamicResource Dash.Overlay}" IsChecked="{Binding Settings.OverlayVisible}" Margin="0,10,0,0" FontSize="12.5" />
                    </StackPanel>
                </Border>

                <StackPanel ToggleButton.Checked="OnNavChecked">
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Tag="&#xE80F;" Content="{DynamicResource Nav.Dashboard}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Dashboard"
                                 IsChecked="{Binding CurrentPageKey, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Dashboard}" />
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Tag="&#xE81C;" Content="{DynamicResource Nav.History}"
                                 Command="{Binding NavigateCommand}" CommandParameter="History"
                                 IsChecked="{Binding CurrentPageKey, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=History}" />
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Tag="&#xE9D2;" Content="{DynamicResource Nav.Statistics}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Statistics"
                                 IsChecked="{Binding CurrentPageKey, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Statistics}" />
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Tag="&#xE716;" Content="{DynamicResource Nav.Party}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Party"
                                 IsChecked="{Binding CurrentPageKey, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Party}" />
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Tag="&#xE968;" Content="{DynamicResource Nav.Server}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Server"
                                 IsChecked="{Binding CurrentPageKey, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Server}" />
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Tag="&#xE722;"
                                 Command="{Binding NavigateCommand}" CommandParameter="Detection"
                                 IsChecked="{Binding CurrentPageKey, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Detection}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Nav.Detection}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            <Border Style="{StaticResource Badge}" Margin="8,0,0,0" Padding="5,1" Background="{StaticResource Brush.WarningSoft}">
                                <TextBlock Text="β" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Brush.Warning}" />
                            </Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Tag="&#xE713;" Content="{DynamicResource Nav.Settings}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Settings"
                                 IsChecked="{Binding CurrentPageKey, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Settings}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Page -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Focusable="False" />

        <!-- Toast -->
        <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,26"
                CornerRadius="12" Padding="18,11" MaxWidth="640" IsHitTestVisible="False"
                Background="{StaticResource Brush.SurfaceAlt}" BorderThickness="1" Effect="{StaticResource Shadow.Soft}">
            <Border.RenderTransform>
                <TranslateTransform Y="0" />
            </Border.RenderTransform>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ToastKind}" Value="{x:Static vm:ToastKind.Success}">
                            <Setter Property="BorderBrush" Value="#6622C55E" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ToastKind}" Value="{x:Static vm:ToastKind.Warning}">
                            <Setter Property="BorderBrush" Value="#88F59E0B" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ToastKind}" Value="{x:Static vm:ToastKind.Error}">
                            <Setter Property="BorderBrush" Value="#AAF43F5E" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsToastVisible}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.35" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding ToastText}" TextWrapping="Wrap" FontSize="13" />
        </Border>
    </Grid>
</Window>
