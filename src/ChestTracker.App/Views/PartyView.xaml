<UserControl x:Class="ChestTracker.App.Views.PartyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ChestTracker.App.ViewModels"
             xmlns:sync="clr-namespace:ChestTracker.Sync;assembly=ChestTracker.Sync"
             Style="{StaticResource PageRoot}">
    <UserControl.Resources>
        <Style x:Key="Section" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Padding" Value="22,18" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,32">
            <!-- Header + connection status -->
            <DockPanel Margin="0,0,0,18">
                <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="{StaticResource Brush.SurfaceAlt}" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource Brush.TextDim}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static sync:SyncStatus.Online}">
                                            <Setter Property="Fill" Value="{StaticResource Brush.Success}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static sync:SyncStatus.Offline}">
                                            <Setter Property="Fill" Value="{StaticResource Brush.Warning}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static sync:SyncStatus.Connecting}">
                                            <Setter Property="Fill" Value="{StaticResource Brush.AccentLight}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource Brush.TextMuted}" MaxWidth="460"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <TextBlock Text="{DynamicResource Party.Title}" Style="{StaticResource Text.H1}" />
            </DockPanel>

            <!-- Not registered -->
            <Border Style="{StaticResource Section}" Visibility="{Binding IsRegistered, Converter={StaticResource InvBoolToVis}}">
                <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                    <TextBlock Text="{DynamicResource Party.ConnectTitle}" Style="{StaticResource Text.H2}" />
                    <TextBlock Text="{DynamicResource Party.ConnectHint}" Style="{StaticResource Text.Caption}" FontSize="12.5" Margin="0,6,0,0" />
                    <Button Content="{DynamicResource Party.OpenServer}" Style="{StaticResource Button.Accent}" HorizontalAlignment="Left"
                            Margin="0,16,0,0" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="Server" />
                </StackPanel>
            </Border>

            <!-- Registered, no party -->
            <Grid Visibility="{Binding IsRegistered, Converter={StaticResource BoolToVis}}">
                <Grid Visibility="{Binding InParty, Converter={StaticResource InvBoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Party.Create}" Style="{StaticResource Text.H2}" />
                            <TextBlock Text="{DynamicResource Party.PartyName}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding NewPartyName, UpdateSourceTrigger=PropertyChanged}" MaxLength="32" />
                            <TextBlock Text="{DynamicResource Party.MaxPlayers}" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding PartySizes}" SelectedItem="{Binding NewPartySize}" Width="90" HorizontalAlignment="Left" />
                            <Button Content="{DynamicResource Party.CreateButton}" Style="{StaticResource Button.Accent}" HorizontalAlignment="Left"
                                    Margin="0,16,0,0" Command="{Binding CreatePartyCommand}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Party.Join}" Style="{StaticResource Text.H2}" />
                            <TextBlock Text="{DynamicResource Party.Code}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding JoinCode, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="18"
                                     CharacterCasing="Upper" MaxLength="12" />
                            <Button Content="{DynamicResource Party.JoinButton}" Style="{StaticResource Button.Accent}" HorizontalAlignment="Left"
                                    Margin="0,16,0,0" Command="{Binding JoinPartyCommand}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- In party -->
            <Grid Visibility="{Binding InParty, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="2*" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <!-- Party hero -->
                    <Border CornerRadius="18" Padding="24,20" Background="{StaticResource Brush.HeroGradient}" BorderBrush="#40A855F7"
                            BorderThickness="1" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding PartyName}" Style="{StaticResource Text.H2}" FontSize="20" />
                                    <Border Style="{StaticResource Badge}" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding MembersText}" FontSize="11.5" FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource Party.InviteCode}" Style="{StaticResource Text.Label}" Margin="0,12,0,2" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding InviteCode}" FontFamily="Consolas" FontSize="28" FontWeight="Bold"
                                               Foreground="{StaticResource Brush.AccentLight}" VerticalAlignment="Center" />
                                    <Button Style="{StaticResource Button.Icon}" Content="&#xE8C8;" Margin="12,0,0,0" Command="{Binding CopyCodeCommand}"
                                            ToolTip="{DynamicResource Party.Copy}" />
                                    <Button Style="{StaticResource Button.Icon}" Content="&#xE72C;" Margin="6,0,0,0" Command="{Binding RegenerateCodeCommand}"
                                            ToolTip="{DynamicResource Party.Regenerate}"
                                            Visibility="{Binding IsOwner, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <TextBlock Text="{Binding InviteExpires}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel Margin="0,0,28,0">
                                    <TextBlock Text="{DynamicResource Party.TeamMatch}" Style="{StaticResource Text.Label}" />
                                    <TextBlock Text="{Binding TeamMatchText}" FontSize="34" FontWeight="Bold" FontFamily="{StaticResource Font.Display}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Party.TeamLifetime}" Style="{StaticResource Text.Label}" />
                                    <TextBlock Text="{Binding TeamLifetimeText}" FontSize="34" FontWeight="Bold" FontFamily="{StaticResource Font.Display}"
                                               Foreground="{StaticResource Brush.AccentLight}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Members -->
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Party.Members}" Style="{StaticResource Text.H2}" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding Members}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PartyMemberItem}">
                                        <Border Padding="2,8" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse x:Name="Dot" Width="9" Height="9" Fill="{StaticResource Brush.TextDim}" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock x:Name="NameText" Text="{Binding Name}" FontSize="13.5" />
                                                        <TextBlock Text="  &#xE734;" Style="{StaticResource Text.Icon}" FontSize="11" Foreground="{StaticResource Brush.Gold}"
                                                                   Visibility="{Binding IsOwner, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding ResponseText}" Style="{StaticResource Text.Caption}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{DynamicResource Party.Col.Match}" Style="{StaticResource Text.Caption}" />
                                                    <TextBlock Text="{Binding MatchText}" FontWeight="Bold" FontSize="15" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                    <TextBlock Text="{DynamicResource Party.Col.Lifetime}" Style="{StaticResource Text.Caption}" />
                                                    <TextBlock Text="{Binding LifetimeText}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource Brush.AccentLight}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center"
                                                            Visibility="{Binding CanManage, Converter={StaticResource BoolToVis}}">
                                                    <Button Style="{StaticResource Button.Icon}" Content="&#xE734;" Margin="0,0,4,0" ToolTip="{DynamicResource Party.MakeOwner}"
                                                            Command="{Binding DataContext.MakeOwnerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Style="{StaticResource Button.Icon}" Content="&#xE711;" Foreground="#FDA4AF" ToolTip="{DynamicResource Party.Kick}"
                                                            Command="{Binding DataContext.KickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Online}" Value="True">
                                                <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Brush.Success}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsMe}" Value="True">
                                                <Setter TargetName="NameText" Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{DynamicResource Party.CountsHint}" Style="{StaticResource Text.Caption}" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Leaderboard -->
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <ComboBox DockPanel.Dock="Right" Width="150" ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod}"
                                          DisplayMemberPath="Label" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Content="&#xE72C;" Margin="0,0,8,0"
                                        Command="{Binding RefreshAllCommand}" />
                                <TextBlock Text="{DynamicResource Party.Leaderboard}" Style="{StaticResource Text.H2}" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="{DynamicResource Party.NoData}" Style="{StaticResource Text.Caption}"
                                       Visibility="{Binding HasLeaderboard, Converter={StaticResource InvBoolToVis}}" />
                            <ItemsControl ItemsSource="{Binding Leaderboard}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:LeaderboardItem}">
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="80" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="Rank" Text="{Binding Rank}" FontWeight="Bold" Foreground="{StaticResource Brush.TextMuted}" />
                                            <TextBlock x:Name="Name" Grid.Column="1" Text="{Binding Name}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Verified}" FontWeight="Bold" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Column="3" Text="{Binding Reported}" Foreground="{StaticResource Brush.TextDim}" HorizontalAlignment="Right" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsFirst}" Value="True">
                                                <Setter TargetName="Rank" Property="Foreground" Value="{StaticResource Brush.Gold}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsMe}" Value="True">
                                                <Setter TargetName="Name" Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid Margin="0,6,0,0" Visibility="{Binding HasLeaderboard, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="2" Text="{DynamicResource Party.Verified}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="3" Text="{DynamicResource Party.Reported}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Shared match history -->
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Party.History}" Style="{StaticResource Text.H2}" Margin="0,0,0,10" />
                            <TextBlock Text="{DynamicResource Party.NoData}" Style="{StaticResource Text.Caption}"
                                       Visibility="{Binding HasHistory, Converter={StaticResource InvBoolToVis}}" />
                            <ItemsControl ItemsSource="{Binding History}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:SharedHistoryItem}">
                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding StartText}" FontFamily="Consolas" />
                                            <TextBlock Grid.Column="1" Text="{Binding DurationText}" Foreground="{StaticResource Brush.TextMuted}" />
                                            <TextBlock Grid.Column="2" Text="{Binding TeamText}" FontWeight="Bold" Foreground="{StaticResource Brush.AccentLight}" />
                                            <TextBlock Grid.Column="3" Text="{Binding PlayersText}" Foreground="{StaticResource Brush.TextMuted}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right column -->
                <StackPanel Grid.Column="2">
                    <!-- Shared match -->
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Party.SharedMatch}" Style="{StaticResource Text.H2}" />
                            <TextBlock Text="{Binding SharedMatchText}" Margin="0,6,0,0" FontSize="13" />
                            <TextBlock Text="{DynamicResource Party.SharedHint}" Style="{StaticResource Text.Caption}" Margin="0,6,0,10" />
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsOwner, Converter={StaticResource BoolToVis}}">
                                <Button Content="{DynamicResource Party.StartShared}" Style="{StaticResource Button.Accent}" Margin="0,0,8,0"
                                        Command="{Binding StartSharedCommand}" />
                                <Button Content="{DynamicResource Party.EndShared}" Command="{Binding EndSharedCommand}"
                                        IsEnabled="{Binding HasActiveMatch}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding HasPendingInvite, Converter={StaticResource BoolToVis}}">
                                <Button Content="{DynamicResource Party.Accept}" Style="{StaticResource Button.Success}" Margin="0,0,8,0"
                                        Command="{Binding AcceptInviteCommand}" />
                                <Button Content="{DynamicResource Party.Decline}" Style="{StaticResource Button.Ghost}" Command="{Binding DeclineInviteCommand}" />
                            </StackPanel>
                            <CheckBox Content="{DynamicResource Party.AutoShare}" IsChecked="{Binding Settings.AutoShareMatches}" Margin="0,12,0,0" />
                            <CheckBox Content="{DynamicResource Party.AutoJoin}" IsChecked="{Binding Settings.AutoJoinSharedMatches}" />
                        </StackPanel>
                    </Border>

                    <!-- Privacy -->
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Party.Privacy}" Style="{StaticResource Text.H2}" Margin="0,0,0,6" />
                            <CheckBox Content="{DynamicResource Party.ShareCounts}" IsChecked="{Binding ShareCounts}" />
                            <CheckBox Content="{DynamicResource Party.ShareActivity}" IsChecked="{Binding ShareActivity}" />
                            <TextBlock Text="{DynamicResource Party.PrivacyHint}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Overlay & notifications -->
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Party.OverlayTitle}" Style="{StaticResource Text.H2}" Margin="0,0,0,6" />
                            <CheckBox Content="{DynamicResource Party.TeamOverlay}" IsChecked="{Binding Settings.OverlayTeamMode}" />
                            <CheckBox Content="{DynamicResource Party.ShowActivity}" IsChecked="{Binding Settings.OverlayShowActivity}" />
                            <CheckBox Content="{DynamicResource Party.Notify}" IsChecked="{Binding Settings.NotifyTeammateChests}" />
                            <CheckBox Content="{DynamicResource Party.Sound}" IsChecked="{Binding Settings.TeammateSound}" />
                        </StackPanel>
                    </Border>

                    <!-- Account -->
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Party.Account}" Style="{StaticResource Text.H2}" Margin="0,0,0,6" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{DynamicResource Party.SaveName}" Margin="8,0,0,0" Command="{Binding SaveNameCommand}" />
                                <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" MaxLength="32" />
                            </DockPanel>
                            <WrapPanel Margin="0,12,0,0">
                                <Button Content="{DynamicResource Party.Leave}" Margin="0,0,8,8" Command="{Binding LeaveCommand}" />
                                <Button Content="{DynamicResource Party.SignOut}" Style="{StaticResource Button.Ghost}" Margin="0,0,8,8" Command="{Binding SignOutCommand}" />
                                <Button Content="{DynamicResource Party.DeleteData}" Style="{StaticResource Button.Danger}" Margin="0,0,8,8"
                                        Command="{Binding DeleteServerDataCommand}" />
                            </WrapPanel>
                            <TextBlock Text="{DynamicResource Party.AccountHint}" Style="{StaticResource Text.Caption}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Registered but no party: account box -->
            <Border Style="{StaticResource Section}" MaxWidth="560" HorizontalAlignment="Left">
                <Border.Visibility>
                    <MultiBinding Converter="{StaticResource RegisteredNoParty}">
                        <Binding Path="IsRegistered" />
                        <Binding Path="InParty" />
                    </MultiBinding>
                </Border.Visibility>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Party.Account}" Style="{StaticResource Text.H2}" Margin="0,0,0,6" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{DynamicResource Party.SaveName}" Margin="8,0,0,0" Command="{Binding SaveNameCommand}" />
                        <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" MaxLength="32" />
                    </DockPanel>
                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="{DynamicResource Party.SignOut}" Style="{StaticResource Button.Ghost}" Margin="0,0,8,8" Command="{Binding SignOutCommand}" />
                        <Button Content="{DynamicResource Party.DeleteData}" Style="{StaticResource Button.Danger}" Margin="0,0,8,8"
                                Command="{Binding DeleteServerDataCommand}" />
                    </WrapPanel>
                    <TextBlock Text="{DynamicResource Party.AccountHint}" Style="{StaticResource Text.Caption}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
