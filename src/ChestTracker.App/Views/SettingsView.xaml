<UserControl x:Class="ChestTracker.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ChestTracker.App.ViewModels"
             xmlns:svc="clr-namespace:ChestTracker.App.Services"
             xmlns:c="clr-namespace:ChestTracker.App.Controls"
             Style="{StaticResource PageRoot}">
    <UserControl.Resources>
        <Style x:Key="Section" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Padding" Value="22,18" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.H2}">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="SliderLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        </Style>
        <Style x:Key="Swatch" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32,28,32,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.ColumnSpan="3" Text="{DynamicResource Set.Title}" Style="{StaticResource Text.H1}" Margin="0,0,0,22" />

            <!-- Left column -->
            <StackPanel Grid.Row="1">
                <!-- General -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Set.General}" Style="{StaticResource SectionTitle}" />
                        <DockPanel Margin="0,4,0,8">
                            <ComboBox DockPanel.Dock="Right" Width="170" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                                      DisplayMemberPath="Label" />
                            <TextBlock Text="{DynamicResource Set.Language}" VerticalAlignment="Center" FontSize="13" />
                        </DockPanel>
                        <CheckBox Content="{DynamicResource Set.StartWithWindows}" IsChecked="{Binding StartWithWindows}" />
                        <CheckBox Content="{DynamicResource Set.StartMinimized}" IsChecked="{Binding StartMinimized}" />
                        <CheckBox Content="{DynamicResource Set.MinimizeToTray}" IsChecked="{Binding MinimizeToTray}" />
                        <CheckBox Content="{DynamicResource Set.CloseToTray}" IsChecked="{Binding CloseToTray}" />
                        <CheckBox Content="{DynamicResource Set.Sounds}" IsChecked="{Binding SoundsEnabled}" />
                        <DockPanel Margin="0,8,0,0" IsEnabled="{Binding SoundsEnabled}">
                            <Button DockPanel.Dock="Right" Content="{DynamicResource Set.TestSound}" Style="{StaticResource Button.Ghost}"
                                    Padding="10,5" Command="{Binding TestSoundCommand}" />
                            <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Set.Volume}" Style="{StaticResource SliderLabel}" Width="110"
                                       VerticalAlignment="Center" />
                            <Slider Minimum="0" Maximum="1" Value="{Binding SoundVolume}" Margin="0,0,12,0" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Tracking -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Set.Tracking}" Style="{StaticResource SectionTitle}" />
                        <Border Background="{StaticResource Brush.SurfaceAlt}" CornerRadius="10" Padding="4">
                            <UniformGrid Columns="3">
                                <RadioButton Style="{StaticResource Segment}" GroupName="SetMode" Content="{DynamicResource Mode.Manual}"
                                             IsChecked="{Binding TrackingMode, Converter={StaticResource EnumEquals}, ConverterParameter=Manual}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="SetMode" Content="{DynamicResource Mode.Hybrid}"
                                             IsChecked="{Binding TrackingMode, Converter={StaticResource EnumEquals}, ConverterParameter=Hybrid}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="SetMode" Content="{DynamicResource Mode.Automatic}"
                                             IsChecked="{Binding TrackingMode, Converter={StaticResource EnumEquals}, ConverterParameter=Automatic}" />
                            </UniformGrid>
                        </Border>
                        <CheckBox Content="{DynamicResource Set.AutoStart}" IsChecked="{Binding AutoStartMatch}" Margin="0,12,0,4" />

                        <DockPanel Margin="0,10,0,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <TextBlock Text="{Binding ManualDebounceMs}" FontWeight="SemiBold" />
                                <TextBlock Text=" " />
                                <TextBlock Text="{DynamicResource Common.Ms}" Foreground="{StaticResource Brush.TextMuted}" />
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Set.Debounce}" Style="{StaticResource SliderLabel}" />
                        </DockPanel>
                        <Slider Minimum="0" Maximum="1000" Value="{Binding ManualDebounceMs}" />

                        <DockPanel Margin="0,8,0,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <TextBlock Text="{Binding HybridMergeWindowSeconds, StringFormat={}{0:0.0}}" FontWeight="SemiBold" />
                                <TextBlock Text=" " />
                                <TextBlock Text="{DynamicResource Common.Seconds}" Foreground="{StaticResource Brush.TextMuted}" />
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Set.MergeWindow}" Style="{StaticResource SliderLabel}" TextWrapping="Wrap" />
                        </DockPanel>
                        <Slider Minimum="0" Maximum="6" Value="{Binding HybridMergeWindowSeconds}" />

                        <DockPanel Margin="0,8,0,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <TextBlock Text="{Binding ResumeWindowMinutes}" FontWeight="SemiBold" />
                                <TextBlock Text=" " />
                                <TextBlock Text="{DynamicResource Common.Minutes}" Foreground="{StaticResource Brush.TextMuted}" />
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Set.ResumeWindow}" Style="{StaticResource SliderLabel}" TextWrapping="Wrap" />
                        </DockPanel>
                        <Slider Minimum="0" Maximum="60" Value="{Binding ResumeWindowMinutes}" />
                    </StackPanel>
                </Border>

                <!-- Hotkeys -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{DynamicResource Set.ResetHotkeys}" Style="{StaticResource Button.Ghost}"
                                    Padding="10,5" Command="{Binding ResetHotkeysCommand}" />
                            <TextBlock Text="{DynamicResource Set.Hotkeys}" Style="{StaticResource SectionTitle}" />
                        </DockPanel>
                        <CheckBox Content="{DynamicResource Set.HotkeysEnabled}" IsChecked="{Binding HotkeysEnabled}" />
                        <TextBlock Text="{DynamicResource Set.HotkeysHint}" Style="{StaticResource Text.Caption}" Margin="0,6,0,10" />
                        <ItemsControl ItemsSource="{Binding Hotkeys}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:HotkeyBindingViewModel}">
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" FontSize="13" />
                                            <TextBlock x:Name="Status" Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource Brush.TextDim}" />
                                        </StackPanel>
                                        <c:HotkeyBox Grid.Column="1" BindingValue="{Binding Binding, Mode=TwoWay}" Padding="10,7" FontFamily="Consolas" />
                                        <Button Grid.Column="2" Style="{StaticResource Button.Icon}" Content="&#xE711;" Margin="6,0,0,0"
                                                Command="{Binding ClearCommand}" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static svc:HotkeyStatus.Ok}">
                                            <Setter TargetName="Status" Property="Foreground" Value="{StaticResource Brush.Success}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static svc:HotkeyStatus.Duplicate}">
                                            <Setter TargetName="Status" Property="Foreground" Value="{StaticResource Brush.Danger}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static svc:HotkeyStatus.External}">
                                            <Setter TargetName="Status" Property="Foreground" Value="{StaticResource Brush.Warning}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Right column -->
            <StackPanel Grid.Row="1" Grid.Column="2">
                <!-- Overlay -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Set.Overlay}" Style="{StaticResource SectionTitle}" />
                        <CheckBox Content="{DynamicResource Set.OverlayVisible}" IsChecked="{Binding OverlayVisible}" />
                        <CheckBox Content="{DynamicResource Set.OverlayEdit}"
                                  IsChecked="{Binding DataContext.Overlay.IsEditMode, RelativeSource={RelativeSource AncestorType=Window}}" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Set.Layout}" Style="{StaticResource Text.Label}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding Layouts}" SelectedItem="{Binding SelectedLayout}" DisplayMemberPath="Label" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource Set.Preset}" Style="{StaticResource Text.Label}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Label" />
                            </StackPanel>
                        </Grid>

                        <DockPanel Margin="0,12,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding OverlayOpacity, Converter={StaticResource Percent}}" FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource Set.Opacity}" Style="{StaticResource SliderLabel}" />
                        </DockPanel>
                        <Slider Minimum="0.15" Maximum="1" Value="{Binding OverlayOpacity}" />
                        <DockPanel Margin="0,6,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding OverlayScale, StringFormat={}{0:0.00}×}" FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource Set.Scale}" Style="{StaticResource SliderLabel}" />
                        </DockPanel>
                        <Slider Minimum="0.5" Maximum="2.5" Value="{Binding OverlayScale}" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Set.TextColor}" Style="{StaticResource Text.Label}" Margin="0,0,0,4" />
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="8" Margin="0,0,8,0" BorderBrush="#33FFFFFF" BorderThickness="1"
                                            Background="{Binding DataContext.Overlay.TextBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <TextBox Text="{Binding OverlayTextColor}" FontFamily="Consolas" />
                                </DockPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource Set.AccentColor}" Style="{StaticResource Text.Label}" Margin="0,0,0,4" />
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="8" Margin="0,0,8,0" BorderBrush="#33FFFFFF" BorderThickness="1"
                                            Background="{Binding DataContext.Overlay.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <TextBox Text="{Binding OverlayAccentColor}" FontFamily="Consolas" />
                                </DockPanel>
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Style="{StaticResource Swatch}" Background="#C084FC" Command="{Binding SetAccentCommand}" CommandParameter="#C084FC" />
                            <Button Style="{StaticResource Swatch}" Background="#FBBF24" Command="{Binding SetAccentCommand}" CommandParameter="#FBBF24" />
                            <Button Style="{StaticResource Swatch}" Background="#22D3EE" Command="{Binding SetAccentCommand}" CommandParameter="#22D3EE" />
                            <Button Style="{StaticResource Swatch}" Background="#4ADE80" Command="{Binding SetAccentCommand}" CommandParameter="#4ADE80" />
                            <Button Style="{StaticResource Swatch}" Background="#F472B6" Command="{Binding SetAccentCommand}" CommandParameter="#F472B6" />
                            <Button Style="{StaticResource Swatch}" Background="#F87171" Command="{Binding SetAccentCommand}" CommandParameter="#F87171" />
                            <Button Style="{StaticResource Swatch}" Background="#FFFFFF" Command="{Binding SetAccentCommand}" CommandParameter="#FFFFFF" />
                        </StackPanel>

                        <CheckBox Content="{DynamicResource Set.ShowBackground}" IsChecked="{Binding OverlayShowBackground}" Margin="0,12,0,4" />
                        <Grid IsEnabled="{Binding OverlayShowBackground}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Set.BackgroundColor}" Style="{StaticResource Text.Label}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding OverlayBackgroundColor}" FontFamily="Consolas" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding OverlayBackgroundOpacity, Converter={StaticResource Percent}}" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="{DynamicResource Set.BackgroundOpacity}" Style="{StaticResource Text.Label}" />
                                </DockPanel>
                                <Slider Minimum="0" Maximum="1" Value="{Binding OverlayBackgroundOpacity}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <CheckBox Content="{DynamicResource Set.ShowTimer}" IsChecked="{Binding OverlayShowTimer}" Margin="0,12,0,4" />
                        <CheckBox Content="{DynamicResource Set.ShowDetection}" IsChecked="{Binding OverlayShowDetection}" />
                        <CheckBox Content="{DynamicResource Set.ExcludeCapture}" IsChecked="{Binding OverlayExcludeFromCapture}" />
                        <Button Content="{DynamicResource Set.ResetPosition}" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left"
                                Margin="-8,6,0,0" Command="{Binding ResetOverlayPositionCommand}" />
                        <TextBlock Text="{DynamicResource Set.OverlayNote}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- Discord Rich Presence -->
                <Border Style="{StaticResource Section}" DataContext="{Binding Discord}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="{StaticResource Brush.SurfaceAlt}" MaxWidth="260">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource Brush.TextDim}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource Brush.Success}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding StatusText}" FontSize="11.5" Foreground="{StaticResource Brush.TextMuted}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{DynamicResource Discord.Title}" Style="{StaticResource SectionTitle}" Margin="0" />
                        </DockPanel>

                        <!-- Preview: mimics Discord's profile activity card -->
                        <TextBlock Text="{DynamicResource Discord.Preview}" Style="{StaticResource Text.Label}" Margin="0,4,0,6" />
                        <Border Background="#111214" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                            <Grid>
                                <TextBlock Text="{Binding PreviewHiddenText}" Foreground="#B5BAC1" FontSize="12.5"
                                           Visibility="{Binding PreviewVisible, Converter={StaticResource InvBoolToVis}}" />
                                <StackPanel Visibility="{Binding PreviewVisible, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{DynamicResource Discord.Playing}" FontSize="11" FontWeight="Bold" Foreground="#B5BAC1" Margin="0,0,0,8" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="68" Height="68" VerticalAlignment="Top" Margin="0,0,12,0">
                                            <Border CornerRadius="8" ClipToBounds="True" ToolTip="{Binding PreviewLargeText}">
                                                <Image Source="{Binding Logo}" />
                                            </Border>
                                            <Border Width="24" Height="24" CornerRadius="12" Background="#111214" Padding="2" HorizontalAlignment="Right"
                                                    VerticalAlignment="Bottom" Margin="0,0,-5,-5" ToolTip="{Binding PreviewSmallText}">
                                                <Image Source="{Binding PreviewSmallImage}" />
                                            </Border>
                                        </Grid>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Chest Tracker" FontWeight="Bold" FontSize="13" Foreground="#F2F3F5" />
                                            <TextBlock Text="{Binding PreviewDetails}" FontSize="12.5" Foreground="#DBDEE1" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding PreviewState}" FontSize="12.5" Foreground="#DBDEE1" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding PreviewElapsed}" FontSize="12.5" Foreground="#DBDEE1"
                                                       Visibility="{Binding PreviewElapsed, Converter={StaticResource NullToVis}}" />
                                        </StackPanel>
                                    </Grid>
                                    <Border Background="#4E5058" CornerRadius="4" Padding="0,7" Margin="0,10,0,0"
                                            Visibility="{Binding PreviewButton, Converter={StaticResource NullToVis}}">
                                        <TextBlock Text="{Binding PreviewButton}" HorizontalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" Foreground="White" />
                                    </Border>
                                    <TextBlock Text="{Binding PreviewLargeText}" FontSize="11" Foreground="#949BA4" Margin="0,8,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <CheckBox Content="{DynamicResource Discord.Enabled}" IsChecked="{Binding Enabled}" />
                        <TextBlock Text="{DynamicResource Discord.AppId}" Style="{StaticResource Text.Label}" Margin="0,8,0,4" />
                        <TextBlock Text="{Binding ApplicationId, Mode=OneTime}" FontFamily="Consolas" Foreground="{StaticResource Brush.TextMuted}" />
                        <TextBlock Text="{Binding AssetText}" TextWrapping="Wrap" Margin="0,4,0,8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AssetsOk}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Success}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding AssetsMissing}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <CheckBox Content="{DynamicResource Discord.ShowNickname}" IsChecked="{Binding ShowNickname}" />
                        <TextBox Text="{Binding Nickname, UpdateSourceTrigger=LostFocus}" MaxLength="32" Margin="0,2,0,4"
                                 IsEnabled="{Binding ShowNickname}" ToolTip="{DynamicResource Discord.NicknameHint}" />
                        <TextBlock Text="{DynamicResource Discord.NicknameHint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding NicknameInfo}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,6"
                                   Foreground="{StaticResource Brush.AccentLight}"
                                   Visibility="{Binding NicknameInfo, Converter={StaticResource NullToVis}}" />
                        <CheckBox Content="{DynamicResource Discord.ShowTeam}" IsChecked="{Binding ShowTeam}" />
                        <CheckBox Content="{DynamicResource Discord.ShowTimer}" IsChecked="{Binding ShowTimer}" />
                        <CheckBox Content="{DynamicResource Discord.ShowLifetime}" IsChecked="{Binding ShowLifetime}" />
                        <CheckBox Content="{DynamicResource Discord.HideNoFortnite}" IsChecked="{Binding HideWhenFortniteNotRunning}" />

                        <TextBlock Text="{DynamicResource Discord.Priority}" Style="{StaticResource Text.Label}" Margin="0,10,0,4" />
                        <ComboBox ItemsSource="{Binding Priorities}" SelectedItem="{Binding SelectedPriority}" DisplayMemberPath="Label" />

                        <TextBlock Text="{DynamicResource Discord.ProjectUrl}" Style="{StaticResource Text.Label}" Margin="0,10,0,4" />
                        <TextBlock Text="{Binding ProjectUrl, Mode=OneTime}" FontFamily="Consolas" TextWrapping="Wrap"
                                   Foreground="{StaticResource Brush.TextMuted}" />
                        <TextBlock Text="{DynamicResource Discord.Privacy}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- Detection link -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="{DynamicResource Nav.Detection}" Style="{StaticResource Text.H2}" />
                            <Border Style="{StaticResource Badge}" Background="{StaticResource Brush.WarningSoft}" Margin="10,0,0,0">
                                <TextBlock Text="{DynamicResource Common.Experimental}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Brush.Warning}" />
                            </Border>
                        </StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Sensitivity}" FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource Det.Sensitivity}" Style="{StaticResource SliderLabel}" />
                        </DockPanel>
                        <Slider Minimum="0" Maximum="100" Value="{Binding Sensitivity}" IsSnapToTickEnabled="True" TickFrequency="1" />
                        <DockPanel Margin="0,6,0,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <TextBlock Text="{Binding CooldownSeconds, StringFormat={}{0:0.0}}" FontWeight="SemiBold" />
                                <TextBlock Text=" " />
                                <TextBlock Text="{DynamicResource Common.Seconds}" Foreground="{StaticResource Brush.TextMuted}" />
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Det.Cooldown}" Style="{StaticResource SliderLabel}" />
                        </DockPanel>
                        <Slider Minimum="0.5" Maximum="15" Value="{Binding CooldownSeconds}" />
                        <TextBlock Text="{DynamicResource Set.DetectionLink}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- Data -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Set.Data}" Style="{StaticResource SectionTitle}" />
                        <WrapPanel>
                            <Button Content="{DynamicResource Set.ExportJson}" Command="{Binding ExportJsonCommand}" Margin="0,0,8,8" />
                            <Button Content="{DynamicResource Set.ImportJson}" Command="{Binding ImportJsonCommand}" Margin="0,0,8,8" />
                            <Button Content="{DynamicResource Set.ExportCsv}" Command="{Binding ExportCsvCommand}" Margin="0,0,8,8" />
                            <Button Content="{DynamicResource Set.BackupNow}" Command="{Binding BackupNowCommand}" Margin="0,0,8,8" />
                            <Button Content="{DynamicResource Set.OpenFolder}" Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,8" />
                            <Button Content="{DynamicResource Set.Lifetime}" Command="{Binding AdjustLifetimeCommand}" Margin="0,0,8,8" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,12">
                            <Run Text="{DynamicResource Set.DataPath}" /><Run Text=": " /><Run Text="{Binding DataFolder, Mode=OneWay}" />
                        </TextBlock>
                        <Button Content="{DynamicResource Set.ResetAll}" Style="{StaticResource Button.Danger}" HorizontalAlignment="Left"
                                Command="{Binding ResetAllCommand}" />
                    </StackPanel>
                </Border>

                <!-- About -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Set.About}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{DynamicResource Set.AboutText}" Style="{StaticResource Text.Caption}" FontSize="12.5" LineHeight="19" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
