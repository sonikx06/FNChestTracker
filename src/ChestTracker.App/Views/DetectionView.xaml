<UserControl x:Class="ChestTracker.App.Views.DetectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ChestTracker.App.ViewModels"
             xmlns:c="clr-namespace:ChestTracker.App.Controls"
             Style="{StaticResource PageRoot}">
    <UserControl.Resources>
        <Style x:Key="Metric" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.SurfaceAlt}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="4" />
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Margin" Value="0,12,0,2" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,32">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                <TextBlock Text="{DynamicResource Det.Title}" Style="{StaticResource Text.H1}" />
                <Border Style="{StaticResource Badge}" Background="{StaticResource Brush.WarningSoft}" Margin="14,4,0,0">
                    <TextBlock Text="{DynamicResource Common.Experimental}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Brush.Warning}" />
                </Border>
            </StackPanel>

            <Border Style="{StaticResource Card}" Background="#1AF59E0B" BorderBrush="#55F59E0B" Margin="0,0,0,16">
                <DockPanel>
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Text.Icon}" FontSize="18" Foreground="{StaticResource Brush.Warning}"
                               VerticalAlignment="Top" Margin="0,2,14,0" />
                    <TextBlock Text="{DynamicResource Det.Warning}" TextWrapping="Wrap" FontSize="12.5" LineHeight="19" Foreground="#FDE68A" />
                </DockPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="{Binding IsActiveMode, Converter={StaticResource InvBoolToVis}}">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Background="{StaticResource Brush.SurfaceAlt}" CornerRadius="10" Padding="4">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" GroupName="DetMode" Content="{DynamicResource Mode.Manual}"
                                         IsChecked="{Binding Settings.TrackingMode, Converter={StaticResource EnumEquals}, ConverterParameter=Manual}" />
                            <RadioButton Style="{StaticResource Segment}" GroupName="DetMode" Content="{DynamicResource Mode.Hybrid}"
                                         IsChecked="{Binding Settings.TrackingMode, Converter={StaticResource EnumEquals}, ConverterParameter=Hybrid}" />
                            <RadioButton Style="{StaticResource Segment}" GroupName="DetMode" Content="{DynamicResource Mode.Automatic}"
                                         IsChecked="{Binding Settings.TrackingMode, Converter={StaticResource EnumEquals}, ConverterParameter=Automatic}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{DynamicResource Det.ModeHint}" VerticalAlignment="Center" FontSize="13.5" />
                </DockPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="2*" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <!-- Left: live view -->
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Command="{Binding RestartCommand}" Padding="12,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;" Style="{StaticResource Text.Icon}" FontSize="12" Margin="0,0,8,0" />
                                        <TextBlock Text="{DynamicResource Det.Restart}" />
                                    </StackPanel>
                                </Button>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="10" Height="10" Margin="0,0,10,0"
                                             Fill="{Binding DataContext.Overlay.DetectionBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.H2}" FontSize="15" />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Text="{Binding SourceText}" Style="{StaticResource Text.Caption}" Margin="20,4,0,0" />
                            <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource Brush.Danger}" FontSize="12" TextWrapping="Wrap" Margin="20,4,0,0"
                                       Visibility="{Binding ErrorText, Converter={StaticResource NullToVis}}" />

                            <TextBlock Text="{DynamicResource Det.Live}" Style="{StaticResource Text.Label}" Margin="0,16,0,4" />
                            <UniformGrid Columns="6" Margin="-4,0">
                                <Border Style="{StaticResource Metric}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Det.GoldRatio}" Style="{StaticResource Text.Caption}" />
                                        <TextBlock Text="{Binding GoldText}" Style="{StaticResource MetricValue}" Foreground="{StaticResource Brush.Gold}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Metric}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Det.Brightness}" Style="{StaticResource Text.Caption}" />
                                        <TextBlock Text="{Binding BrightnessText}" Style="{StaticResource MetricValue}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Metric}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Det.Motion}" Style="{StaticResource Text.Caption}" />
                                        <TextBlock Text="{Binding MotionText}" Style="{StaticResource MetricValue}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Metric}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Det.TemplateScore}" Style="{StaticResource Text.Caption}" />
                                        <TextBlock Text="{Binding TemplateText}" Style="{StaticResource MetricValue}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Metric}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Det.Confidence}" Style="{StaticResource Text.Caption}" />
                                        <TextBlock Text="{Binding ConfidenceText}" Style="{StaticResource MetricValue}" Foreground="{StaticResource Brush.AccentLight}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Metric}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Det.Analysis}" Style="{StaticResource Text.Caption}" />
                                        <TextBlock Text="{Binding AnalysisText}" Style="{StaticResource MetricValue}" FontSize="15" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <c:SimpleChart Height="130" Margin="0,12,0,0" Kind="Line" Points="{Binding ConfidenceHistory}" FixedMaximum="100"
                                           ValueFormat="0'%'" EmptyText="{DynamicResource Det.PreviewOff}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Det.Preview}" Style="{StaticResource Text.Label}" Margin="0,0,0,10" />
                            <Border CornerRadius="10" Background="#08FFFFFF" MinHeight="160" ClipToBounds="True">
                                <Grid>
                                    <TextBlock Text="{DynamicResource Det.PreviewOff}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" Visibility="{Binding Preview, Converter={StaticResource InvNullToVis}}" />
                                    <Image Source="{Binding Preview}" Stretch="Uniform" MaxHeight="320" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding YoloText}" Style="{StaticResource Text.Caption}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Visibility="{Binding YoloText, Converter={StaticResource NullToVis}}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Content="&#xE74D;" Command="{Binding ClearLogCommand}" />
                                <TextBlock Text="{DynamicResource Det.Log}" Style="{StaticResource Text.H2}" FontSize="15" VerticalAlignment="Center" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Log}" MaxHeight="260">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:DetectionLogItem}">
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{Binding TimeText}" FontFamily="Consolas" Foreground="{StaticResource Brush.TextMuted}" />
                                            <TextBlock Grid.Column="1" Text="{Binding ConfidenceText}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="2" Text="{Binding ResultText}" Foreground="{StaticResource Brush.TextMuted}" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Detail}" FontFamily="Consolas" FontSize="10.5"
                                                       TextWrapping="Wrap" Foreground="{StaticResource Brush.TextDim}"
                                                       Visibility="{Binding Detail, Converter={StaticResource NullToVis}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: calibration -->
                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel DataContext="{Binding Settings}">
                        <TextBlock Text="{DynamicResource Det.Calibration}" Style="{StaticResource Text.H2}" />

                        <!-- EXPERIMENTAL: detection engine -->
                        <TextBlock Text="{DynamicResource Det.Engine}" Style="{StaticResource RowLabel}" />
                        <ComboBox ItemsSource="{Binding Engines}" SelectedItem="{Binding SelectedEngine}" DisplayMemberPath="Label"
                                  AutomationProperties.AutomationId="DetectionEngine" />
                        <StackPanel Visibility="{Binding IsYolo, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{DynamicResource Det.YoloHint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            <TextBlock Text="{DynamicResource Det.ModelPath}" Style="{StaticResource RowLabel}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="…" Margin="6,0,0,0" Padding="10,5" Command="{Binding BrowseModelCommand}" />
                                <TextBox Text="{Binding YoloModelPath, UpdateSourceTrigger=LostFocus}" FontFamily="Consolas" FontSize="11"
                                         ToolTip="{Binding YoloModelPlaceholder}" />
                            </DockPanel>
                            <TextBlock Text="{Binding DataContext.ModelText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding DataContext.ModelError, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Foreground="{StaticResource Brush.Danger}"
                                       Visibility="{Binding DataContext.ModelError, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NullToVis}}" />
                            <DockPanel Margin="0,10,0,0">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding YoloConfidence, StringFormat={}{0:0.00}}" FontWeight="SemiBold" />
                                <TextBlock Text="{DynamicResource Det.YoloConfidence}" Style="{StaticResource Text.Label}" FontSize="12.5" />
                            </DockPanel>
                            <Slider Minimum="0.05" Maximum="0.95" Value="{Binding YoloConfidence}" />
                            <CheckBox Content="{DynamicResource Det.DebugView}" IsChecked="{Binding DebugView}" Margin="0,8,0,0" />
                        </StackPanel>

                        <TextBlock Text="{DynamicResource Det.Backend}" Style="{StaticResource RowLabel}" />
                        <ComboBox ItemsSource="{Binding Backends}" SelectedItem="{Binding SelectedBackend}" DisplayMemberPath="Label" />
                        <TextBlock Text="{DynamicResource Det.Target}" Style="{StaticResource RowLabel}" />
                        <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}" DisplayMemberPath="Label" />

                        <CheckBox Content="{DynamicResource Det.TestMode}" IsChecked="{Binding TestMode}" Margin="0,14,0,4" />
                        <CheckBox Content="{DynamicResource Det.QueueUncertain}" IsChecked="{Binding QueueUncertain}" />

                        <DockPanel Margin="0,12,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Sensitivity}" FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource Det.Sensitivity}" Style="{StaticResource Text.Label}" FontSize="12.5" />
                        </DockPanel>
                        <Slider Minimum="0" Maximum="100" Value="{Binding Sensitivity}" IsSnapToTickEnabled="True" TickFrequency="1" />

                        <DockPanel Margin="0,8,0,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <TextBlock Text="{Binding CooldownSeconds, StringFormat={}{0:0.0}}" FontWeight="SemiBold" />
                                <TextBlock Text=" " />
                                <TextBlock Text="{DynamicResource Common.Seconds}" Foreground="{StaticResource Brush.TextMuted}" />
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Det.Cooldown}" Style="{StaticResource Text.Label}" FontSize="12.5" />
                        </DockPanel>
                        <Slider Minimum="0.5" Maximum="15" Value="{Binding CooldownSeconds}" />

                        <DockPanel Margin="0,8,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SamplingFps}" FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource Det.Fps}" Style="{StaticResource Text.Label}" FontSize="12.5" />
                        </DockPanel>
                        <Slider Minimum="1" Maximum="10" Value="{Binding SamplingFps}" IsSnapToTickEnabled="True" TickFrequency="1" />

                        <TextBlock Text="{DynamicResource Det.Roi}" Style="{StaticResource Text.H2}" FontSize="14" Margin="0,18,0,0" />
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding RoiWidth, Converter={StaticResource Percent}}" FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource Det.RoiWidth}" Style="{StaticResource Text.Label}" FontSize="12.5" />
                        </DockPanel>
                        <Slider Minimum="0.1" Maximum="1" Value="{Binding RoiWidth}" />
                        <DockPanel Margin="0,6,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding RoiHeight, Converter={StaticResource Percent}}" FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource Det.RoiHeight}" Style="{StaticResource Text.Label}" FontSize="12.5" />
                        </DockPanel>
                        <Slider Minimum="0.1" Maximum="1" Value="{Binding RoiHeight}" />
                        <DockPanel Margin="0,6,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding RoiCenterY, Converter={StaticResource Percent}}" FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource Det.RoiCenterY}" Style="{StaticResource Text.Label}" FontSize="12.5" />
                        </DockPanel>
                        <Slider Minimum="0.2" Maximum="0.8" Value="{Binding RoiCenterY}" />

                        <TextBlock Text="{DynamicResource Det.Gold}" Style="{StaticResource Text.H2}" FontSize="14" Margin="0,18,0,0" />
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding GoldHueMin}" FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource Det.HueMin}" Style="{StaticResource Text.Label}" FontSize="12.5" />
                        </DockPanel>
                        <Slider Minimum="0" Maximum="60" Value="{Binding GoldHueMin}" IsSnapToTickEnabled="True" TickFrequency="1" />
                        <DockPanel Margin="0,6,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding GoldHueMax}" FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource Det.HueMax}" Style="{StaticResource Text.Label}" FontSize="12.5" />
                        </DockPanel>
                        <Slider Minimum="0" Maximum="60" Value="{Binding GoldHueMax}" IsSnapToTickEnabled="True" TickFrequency="1" />
                        <DockPanel Margin="0,6,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding GoldSaturationMin}" FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource Det.SatMin}" Style="{StaticResource Text.Label}" FontSize="12.5" />
                        </DockPanel>
                        <Slider Minimum="0" Maximum="255" Value="{Binding GoldSaturationMin}" IsSnapToTickEnabled="True" TickFrequency="1" />
                        <DockPanel Margin="0,6,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding GoldValueMin}" FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource Det.ValMin}" Style="{StaticResource Text.Label}" FontSize="12.5" />
                        </DockPanel>
                        <Slider Minimum="0" Maximum="255" Value="{Binding GoldValueMin}" IsSnapToTickEnabled="True" TickFrequency="1" />

                        <TextBlock Text="{DynamicResource Det.Template}" Style="{StaticResource Text.H2}" FontSize="14" Margin="0,18,0,0" />
                        <TextBlock Text="{DynamicResource Det.TemplateHint}" Style="{StaticResource Text.Caption}" Margin="0,6,0,6" />
                        <CheckBox Content="{DynamicResource Det.UseTemplate}" IsChecked="{Binding UseTemplate}" />
                        <TextBlock Text="{Binding DataContext.TemplateStatus, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   Style="{StaticResource Text.Caption}" Margin="0,4,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{DynamicResource Det.CaptureTemplate}" Margin="0,0,8,0"
                                    Command="{Binding DataContext.CaptureTemplateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <Button Content="{DynamicResource Det.ClearTemplate}" Style="{StaticResource Button.Ghost}"
                                    Command="{Binding DataContext.ClearTemplateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </StackPanel>

                        <Button Content="{DynamicResource Set.ResetHotkeys}" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left"
                                Margin="0,18,0,0" Command="{Binding ResetDetectionDefaultsCommand}" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
