<Window x:Class="ChestTracker.App.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ChestTracker.App.Controls"
        Title="Chest Tracker Overlay"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        UseLayoutRounding="True">
    <Window.Resources>
        <DropShadowEffect x:Key="TextShadow" BlurRadius="6" ShadowDepth="0" Color="Black" Opacity="0.85" />
        <Geometry x:Key="ChestGeometry">M2,7 C2,4.8 3.8,3 6,3 L18,3 C20.2,3 22,4.8 22,7 L22,10 L2,10 Z M2,11.5 L22,11.5 L22,20 C22,20.6 21.6,21 21,21 L3,21 C2.4,21 2,20.6 2,20 Z M10,8.5 L14,8.5 L14,14 L10,14 Z</Geometry>
        <Style x:Key="OvLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="Foreground" Value="{Binding TextBrush}" />
            <Setter Property="Effect" Value="{StaticResource TextShadow}" />
        </Style>
        <Style x:Key="OvNumber" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{Binding TextBrush}" />
            <Setter Property="Effect" Value="{StaticResource TextShadow}" />
        </Style>
    </Window.Resources>

    <Grid Opacity="{Binding Opacity}">
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" />
        </Grid.LayoutTransform>

        <Border Background="{Binding PanelBrush}" BorderBrush="{Binding PanelBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14,10"
                Margin="4">
            <StackPanel>
            <Grid>
                <!-- Compact -->
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsCompact, Converter={StaticResource BoolToVis}}">
                    <Path Data="{StaticResource ChestGeometry}" Fill="{Binding AccentBrush}" Width="22" Height="20" Stretch="Uniform"
                          VerticalAlignment="Center" Margin="0,0,10,0" Effect="{StaticResource TextShadow}" />
                    <TextBlock Text="{Binding MatchCount}" Style="{StaticResource OvNumber}" FontSize="30" c:Pulse.OnChange="{Binding MatchCount}" />
                    <Ellipse Width="8" Height="8" Fill="{Binding DetectionBrush}" Margin="10,0,0,0" VerticalAlignment="Center"
                             Visibility="{Binding ShowDetectionIndicator, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <!-- Standard -->
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsStandard, Converter={StaticResource BoolToVis}}">
                    <Path Data="{StaticResource ChestGeometry}" Fill="{Binding AccentBrush}" Width="30" Height="28" Stretch="Uniform"
                          VerticalAlignment="Center" Margin="0,0,12,0" Effect="{StaticResource TextShadow}" />
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Ov.Match}" Style="{StaticResource OvLabel}" />
                            <TextBlock Text="{Binding DurationText}" Style="{StaticResource OvLabel}" Margin="8,0,0,0" FontFamily="Consolas"
                                       Visibility="{Binding ShowTimer, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding MatchCount}" Style="{StaticResource OvNumber}" FontSize="34" Margin="0,-4,0,-4"
                                   c:Pulse.OnChange="{Binding MatchCount}" />
                    </StackPanel>
                    <Rectangle Width="1" Margin="16,4" Fill="{Binding AccentBrush}" Opacity="0.4" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Ov.Lifetime}" Style="{StaticResource OvLabel}" />
                        <TextBlock Text="{Binding LifetimeCount}" Style="{StaticResource OvNumber}" FontSize="22" Foreground="{Binding AccentBrush}" />
                    </StackPanel>
                    <Ellipse Width="8" Height="8" Fill="{Binding DetectionBrush}" Margin="14,0,0,0" VerticalAlignment="Top"
                             Visibility="{Binding ShowDetectionIndicator, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <!-- Expanded -->
                <StackPanel MinWidth="190" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <Ellipse DockPanel.Dock="Right" Width="8" Height="8" Fill="{Binding DetectionBrush}" VerticalAlignment="Center"
                                 Visibility="{Binding ShowDetectionIndicator, Converter={StaticResource BoolToVis}}" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding DurationText}" Style="{StaticResource OvLabel}" FontFamily="Consolas" Margin="0,0,8,0"
                                   Visibility="{Binding ShowTimer, Converter={StaticResource BoolToVis}}" />
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource ChestGeometry}" Fill="{Binding AccentBrush}" Width="14" Height="13" Stretch="Uniform" Margin="0,0,6,0" />
                            <TextBlock Text="{DynamicResource Ov.Match}" Style="{StaticResource OvLabel}" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding MatchCount}" Style="{StaticResource OvNumber}" FontSize="52" Margin="0,-4,0,-2"
                               c:Pulse.OnChange="{Binding MatchCount}" />
                    <Rectangle Height="1" Fill="{Binding AccentBrush}" Opacity="0.35" Margin="0,2,0,6" />
                    <UniformGrid Columns="2">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Ov.Lifetime}" Style="{StaticResource OvLabel}" />
                            <TextBlock Text="{Binding LifetimeCount}" Style="{StaticResource OvNumber}" FontSize="20" Foreground="{Binding AccentBrush}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Ov.Matches}" Style="{StaticResource OvLabel}" />
                            <TextBlock Text="{Binding MatchesPlayed}" Style="{StaticResource OvNumber}" FontSize="20" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>

                <!-- Team -->
                <StackPanel MinWidth="180" Visibility="{Binding IsTeamLayout, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding DurationText}" Style="{StaticResource OvLabel}" FontFamily="Consolas"
                                   Visibility="{Binding ShowTimer, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{DynamicResource Ov.Team}" Style="{StaticResource OvLabel}" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,-2,0,4">
                        <Path Data="{StaticResource ChestGeometry}" Fill="{Binding AccentBrush}" Width="22" Height="20" Stretch="Uniform"
                              VerticalAlignment="Center" Margin="0,0,10,0" Effect="{StaticResource TextShadow}" />
                        <!-- Team · match: the shared match total (— when no shared match is running) -->
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Ov.TeamMatch}" Style="{StaticResource OvLabel}" />
                            <TextBlock Text="{Binding TeamMatchText}" Style="{StaticResource OvNumber}" FontSize="30"
                                       c:Pulse.OnChange="{Binding TeamMatchText}" AutomationProperties.AutomationId="OvTeamMatch" />
                        </StackPanel>
                        <!-- Team · total: the party lifetime total, as on the Party page -->
                        <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                            <TextBlock Text="{DynamicResource Ov.TeamTotal}" Style="{StaticResource OvLabel}" />
                            <TextBlock Text="{Binding TeamLifetimeText}" Style="{StaticResource OvNumber}" FontSize="18"
                                       Foreground="{Binding AccentBrush}" AutomationProperties.AutomationId="OvTeamTotal" />
                        </StackPanel>
                        <!-- Me: this player's own count in the current match -->
                        <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                            <TextBlock Text="{DynamicResource Ov.MeMatch}" Style="{StaticResource OvLabel}" />
                            <TextBlock Text="{Binding MatchCount}" Style="{StaticResource OvNumber}" FontSize="18"
                                       AutomationProperties.AutomationId="OvMyMatch" />
                        </StackPanel>
                    </StackPanel>
                    <Rectangle Height="1" Fill="{Binding AccentBrush}" Opacity="0.35" Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding TeamMembers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,1">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" FontSize="14" FontWeight="Bold" Margin="12,0,0,0"
                                               Foreground="{Binding DataContext.TextBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Effect="{StaticResource TextShadow}" />
                                    <Ellipse x:Name="Dot" Width="7" Height="7" Fill="#71717A" Margin="0,0,7,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="Name" Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" MaxWidth="140"
                                               Foreground="{Binding DataContext.TextBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Effect="{StaticResource TextShadow}" />
                                </DockPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Online}" Value="True">
                                        <Setter TargetName="Dot" Property="Fill" Value="#22C55E" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Online}" Value="False">
                                        <Setter TargetName="Name" Property="Opacity" Value="0.55" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMe}" Value="True">
                                        <Setter TargetName="Name" Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>

            <!-- Recent teammate activity -->
            <TextBlock Text="{Binding ActivityText}" FontSize="11.5" FontWeight="SemiBold" Margin="0,6,0,0" MaxWidth="240"
                       TextTrimming="CharacterEllipsis" Foreground="{Binding AccentBrush}" Effect="{StaticResource TextShadow}"
                       Visibility="{Binding ActivityText, Converter={StaticResource NullToVis}}" />
            </StackPanel>
        </Border>

        <!-- Edit mode frame -->
        <Grid Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}" Background="#01000000" Cursor="SizeAll">
            <Rectangle RadiusX="16" RadiusY="16" Stroke="{Binding AccentBrush}" StrokeThickness="2" StrokeDashArray="3 2" />
            <Border Background="{Binding AccentBrush}" CornerRadius="6" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,-10">
                <TextBlock Text="{DynamicResource Ov.EditHint}" FontSize="10" FontWeight="SemiBold" Foreground="Black" />
            </Border>
        </Grid>
    </Grid>
</Window>
