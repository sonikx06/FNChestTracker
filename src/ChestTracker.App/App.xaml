<Application x:Class="ChestTracker.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ChestTracker.App.ViewModels"
             xmlns:views="clr-namespace:ChestTracker.App.Views"
             xmlns:conv="clr-namespace:ChestTracker.App.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml" />
                <!-- Language dictionary is added at runtime by Loc.SetLanguage (Russian by default). -->
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True" />
            <conv:NullToVisibilityConverter x:Key="NullToVis" />
            <conv:NullToVisibilityConverter x:Key="InvNullToVis" Invert="True" />
            <conv:EnumEqualsConverter x:Key="EnumEquals" />
            <conv:PercentConverter x:Key="Percent" />
            <conv:FirstTrueSecondFalseConverter x:Key="RegisteredNoParty" />
            <conv:ZeroToVisibilityConverter x:Key="ZeroToVis" />

            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
                <views:HistoryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:StatisticsViewModel}">
                <views:StatisticsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DetectionViewModel}">
                <views:DetectionView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PartyViewModel}">
                <views:PartyView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ServerViewModel}">
                <views:ServerView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
