{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://0.0.0.0:5280" }
    }
  },

  "ConnectionStrings": {
    "Postgres": "Host=127.0.0.1;Port=5432;Username=chesttracker;Password=CHANGE_ME;Database=chesttracker"
  },

  "ChestTracker": {
    "SigningKey": "",
    "SigningKeyFile": "data/signing.key",
    "AdminApiKey": "",

    "AllowGuests": true,
    "AllowAccounts": true,
    "MaxPartySize": 4,
    "InviteTtlHours": 24,
    "TokenLifetimeMinutes": 60,

    "MinSecondsBetweenAdds": 1.0,
    "MaxFutureSkewMinutes": 5,
    "MaxEventAgeDays": 14,
    "SharedMatchGraceMinutes": 2,

    "AuthRequestsPerMinute": 30,
    "JoinAttemptsPerMinute": 10,
    "RequestsPerMinute": 300,
    "HubCallsPerSecond": 20,
    "TrustedProxies": [],

    "BackupDirectory": "backups",
    "BackupIntervalHours": 6,
    "BackupKeep": 28,
    "LogDirectory": "logs",
    "LogRetentionDays": 14
  }
}
